  "services": {
    "read_registers": {
      "name": "Read registers",
      "description": "Read a range of controller registers (read-only) and return the non-zero values. Use it to find settings that are not in the documented basic registers: take a dump, change the setting on the stove, take another one and compare.",
      "fields": {
        "config_entry_id": {
          "name": "Stove",
          "description": "Only needed if several stoves are configured."
        },
        "start": {
          "name": "First register",
          "description": "Register number as in the manufacturer's documentation (for example 10101 for the first setting by number)."
        },
        "count": {
          "name": "Number of registers",
          "description": "Up to 5000."
        },
        "include_zero": {
          "name": "Include zeros",
          "description": "Also return registers whose value is 0 (large result)."
        }
      }
    },
    "explore_menu": {
      "name": "Explore the menus",
      "description": "Press navigation keys (Menu, OK, +, -) and read the screens as text. Diagnostic: lists the settings registers that changed.",
      "fields": {
        "config_entry_id": {
          "name": "Stove",
          "description": "Only needed with several stoves."
        },
        "keys": {
          "name": "Keys",
          "description": "List of keys: menu, ok, plus, minus."
        },
        "delay": {
          "name": "Delay",
          "description": "Seconds after each key."
        },
        "each": {
          "name": "Every screen",
          "description": "Return the screen after every key."
        },
        "labels": {
          "name": "Glyph labels",
          "description": "Characters for unknown glyphs."
        },
        "export_font": {
          "name": "Export font",
          "description": "Return the glyph table."
        }
      }
    },
    "set_virtual_thermostat": {
      "name": "Activate a virtual thermostat",
      "description": "Keeps a virtual thermostat of the stove active for N seconds (the stove counts it down by itself, 0 = off, 600 s maximum). Test with the stove running.",
      "fields": {
        "config_entry_id": {
          "name": "Stove",
          "description": "Only needed if several stoves are configured."
        },
        "index": {
          "name": "Thermostat",
          "description": "Virtual thermostat number (0 to 3)."
